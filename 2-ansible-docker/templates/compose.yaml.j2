# Managed by Ansible (playbook.yml) - manual changes are overwritten.
# Hello World page + hit counter. See DECISIONS.md D-001, D-004, D-010.
name: hello-counter

services:
  web:
    build: ./web
    ports:
      # Only this service is published, and only on the host's loopback interface.
      - "127.0.0.1:{{ web_port }}:8000"
    environment:
      COUNTER_URL: http://counter:8000/hit
    networks:
      - frontend
    depends_on:
      counter:
        condition: service_healthy
    healthcheck:
      # http.client ignores HTTP_PROXY, so the check always stays inside the container.
      test: ["CMD", "python", "-c", "import http.client as h; c = h.HTTPConnection('127.0.0.1', 8000, timeout=2); c.request('GET', '/healthz'); exit(c.getresponse().status != 200)"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
    mem_limit: 128m
    restart: unless-stopped

  counter:
    build: ./counter
    environment:
      REDIS_HOST: redis
    networks:
      - frontend
      - backend
    depends_on:
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import http.client as h; c = h.HTTPConnection('127.0.0.1', 8000, timeout=2); c.request('GET', '/healthz'); exit(c.getresponse().status != 200)"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
    mem_limit: 128m
    restart: unless-stopped

  redis:
    image: redis:{{ redis_image_tag }}
    # AOF for durability + RDB snapshot every 60s if at least 1 write (D-004).
    command: ["redis-server", "--appendonly", "yes", "--save", "60", "1"]
    volumes:
      - redis-data:/data
    networks:
      - backend
    healthcheck:
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]
      interval: 5s
      timeout: 3s
      retries: 5
      start_period: 5s
    mem_limit: 128m
    restart: unless-stopped

networks:
  frontend:
  # internal: no route out of this network (Redis needs no internet access).
  backend:
    internal: true

volumes:
  redis-data:
