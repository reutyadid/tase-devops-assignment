# Copy to .env (git-ignored) and set real values: cp .env.example .env
# Fill in every value below, including the SSH key, before the first `docker compose` command:
# Compose checks the Jenkins values even when only Nexus is started.

# Nexus Community Edition blocks uploads until its EULA is accepted (D-012).
# Read https://links.sonatype.com/products/nxrm/ce-eula and set to true only if you agree.
NEXUS_ACCEPT_EULA=false

# Passwords: at least 12 characters, only letters, digits and . _ -
# Generate one with: openssl rand -hex 16

# Replaces the random initial admin password.
NEXUS_ADMIN_PASSWORD=change-me

# Least-privilege user that Jenkins uses to upload to maven-releases (D-011).
NEXUS_DEPLOY_USER=jenkins-deploy
NEXUS_DEPLOY_PASSWORD=change-me

# Jenkins UI login: user "admin".
JENKINS_ADMIN_PASSWORD=change-me

# Public HTTPS URL of this Git repository (the shared library is loaded from it, D-001).
GIT_REPO_URL=https://github.com/YOUR-USER/tase-devops-assignment.git

# Public half of the agent SSH key. Create the key pair once (from 1-jenkins-pipeline/):
#   mkdir -p secrets && ssh-keygen -t ed25519 -N "" -C jenkins-agent -f secrets/agent_key
#   chmod 644 secrets/agent_key     # readable by the jenkins user in the container (D-006)
#   sed -i "s|^JENKINS_AGENT_SSH_PUBKEY=.*|JENKINS_AGENT_SSH_PUBKEY=\"$(cat secrets/agent_key.pub)\"|" .env
# The value has spaces, so it must stay in double quotes (read by both bash and Compose).
# The private key stays in secrets/ (git-ignored) and reaches Jenkins as a Docker secret.
JENKINS_AGENT_SSH_PUBKEY=
