<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example</groupId>
  <artifactId>hello-app</artifactId>
  <!-- CI-friendly version (D-009): CI passes -Drevision=1.0.<build number>. -->
  <version>${revision}</version>
  <packaging>jar</packaging>

  <properties>
    <!-- Default for local builds; CI always overrides it with -Drevision (D-009). -->
    <revision>1.0.0-SNAPSHOT</revision>
    <!-- Compile for Java 21 bytecode and API, whatever JDK runs the build (D-008). -->
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Test-only dependency: not packaged into the jar. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>6.1.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Where `mvn deploy` uploads (D-010). The id must match the <server> id in settings.xml,
       otherwise Maven sends no credentials and Nexus answers 401.
       The host must match <repositoryOrigin> in settings.xml. `nexus` resolves only inside
       the Compose network. Deploy always needs -Drevision=1.0.N: the default version is a
       SNAPSHOT, and only a release repository is defined. -->
  <distributionManagement>
    <repository>
      <id>nexus-releases</id>
      <url>http://nexus:8081/repository/maven-releases/</url>
    </repository>
  </distributionManagement>

  <build>
    <!-- Pin every lifecycle plugin so the build does not depend on Maven's defaults. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Writes .flattened-pom.xml with ${revision} replaced by the real version;
           that file is the POM installed/deployed. Required for CI-friendly versions in Maven 3 (D-009). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <version>1.8.0</version>
        <configuration>
          <updatePomFile>true</updatePomFile>
          <flattenMode>resolveCiFriendliesOnly</flattenMode>
        </configuration>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>process-resources</phase>
            <goals>
              <goal>flatten</goal>
            </goals>
          </execution>
          <execution>
            <id>flatten-clean</id>
            <phase>clean</phase>
            <goals>
              <goal>clean</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <!-- Manifest: runnable jar + SCM trigger parameters set by prepareEnv (D-004).
           Maven reads the env vars directly; no shell is involved (D-001). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.example.app.App</mainClass>
            </manifest>
            <manifestEntries>
              <SCM-Branch>${env.SCM_BRANCH}</SCM-Branch>
              <SCM-Commit>${env.SCM_COMMIT}</SCM-Commit>
              <SCM-Committer>${env.SCM_COMMITTER}</SCM-Committer>
              <SCM-Author>${env.SCM_AUTHOR}</SCM-Author>
              <SCM-Pusher>${env.SCM_PUSHER}</SCM-Pusher>
              <SCM-Repo>${env.SCM_REPO}</SCM-Repo>
            </manifestEntries>
          </archive>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
