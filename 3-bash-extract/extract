#!/usr/bin/env bash
# extract - unpack archives by their content type, not by their name.
# See README.md for usage and DECISIONS.md for design decisions.

# Options (set by parse_args)
verbose=0
recursive=0

# The temp file/folder being written right now ("" = none). cleanup() removes it
# if the script stops in the middle (error, Ctrl+C).
TMP_PATH=""

# --- Supported types: mime type (from `file`) -> how to unpack -------------------
# To add a method, add one line to one of these tables, and add the type to the
# "Supported:" line in usage() (that list is written by hand, see D-002).
# Optional for a stream tool: add its suffix to output_name (else: <name>.out).
# declare -A = associative array (keys are strings). -g = global, so the tables
# stay global even when this file is sourced from inside a function (tests).

# Stream tools: one file in -> one file out. Value = a tool that supports -c (stdout).
# TEMPORARY: read from chunk 6 on (process_target). Remove this line then.
# shellcheck disable=SC2034
declare -gA STREAM_TOOLS=(
    [application/gzip]="gunzip"
    [application/x-gzip]="gunzip"          # older versions of `file`
    [application/x-bzip2]="bunzip2"
    [application/x-compress]="uncompress"
)

# Archive tools: one file in -> many files out. Value = a function below
# that takes: $1 = archive, $2 = folder to extract into.
# TEMPORARY: used from chunk 5 on. Remove this line then.
# shellcheck disable=SC2034
declare -gA ARCHIVE_TOOLS=(
    [application/zip]="unpack_zip"
)

unpack_zip() {
    unzip -o -q "$1" -d "$2"
}

# Print the mime type of a file, based on its content (never its name).
# -L: follow a symlink and report the type of the file it points to (D-006).
detect_type() {
    file -L -b --mime-type -- "$1"
}

# Print the output path for a stream tool (D-003):
# remove a .gz / .bz2 / .Z suffix; if there is none, add .out.
# The suffix only chooses the name. The type was already found by detect_type.
output_name() {
    local path="$1"
    local base=""

    # ${path%.gz} = $path without ".gz" at the end
    case "$path" in
        *.gz)  base="${path%.gz}" ;;
        *.bz2) base="${path%.bz2}" ;;
        *.Z)   base="${path%.Z}" ;;
    esac

    # ${base##*/} = the last part of the path (everything after the last "/").
    local name="${base##*/}"

    # No known suffix, or no real file name left after removing it:
    # ".gz" -> "", "dir/.gz" -> "", "..gz" -> "." (this folder), "...gz" -> ".." (parent).
    # printf, not echo: echo would read a name like "-n" as an option.
    if [[ -z "$name" || "$name" == "." || "$name" == ".." ]]; then
        printf '%s\n' "$path.out"
    else
        printf '%s\n' "$base"
    fi
}

# Unpack one file with a stream tool, next to the file (D-002, D-003, D-005).
# $1 = file, $2 = tool (from STREAM_TOOLS). Returns 0 on success, 1 on failure.
unpack_stream() {
    local file="$1"
    local tool="$2"
    local dir out
    dir=$(dirname -- "$file")
    out=$(output_name "$file")

    if ! command -v "$tool" >/dev/null; then
        warn "$file: '$tool' is not installed"
        return 1
    fi
    if [[ -d "$out" ]]; then
        warn "$file: '$out' is a folder, cannot overwrite it"
        return 1
    fi

    # The error text of the commands below is hidden (2>/dev/null);
    # warn() prints our own message instead, only with -v.

    # An empty temp file in the same folder, so the final mv is a rename.
    if ! TMP_PATH=$(mktemp -- "$dir/.extract.XXXXXX" 2>/dev/null); then
        warn "$file: cannot create a temp file in '$dir'"
        TMP_PATH=""
        return 1
    fi

    # "< file": the tool reads only the content and never sees the name.
    # 2>/dev/null comes first: redirections run left to right, so an error while
    # opening "$file" is hidden too.
    # Any non-zero exit code is a failure (gzip uses 2 for warnings, too).
    if ! "$tool" -c 2>/dev/null < "$file" > "$TMP_PATH"; then
        warn "$file: '$tool' failed"
        cleanup
        return 1
    fi

    # mktemp creates rw------- files; give the output the archive's permissions.
    # mv -T: never move into a folder, even if one appeared after the check above.
    if ! chmod --reference="$file" -- "$TMP_PATH" 2>/dev/null ||
       ! mv -fT -- "$TMP_PATH" "$out" 2>/dev/null; then
        warn "$file: could not write '$out'"
        cleanup
        return 1
    fi
    TMP_PATH=""   # renamed: nothing left to clean up
}

# Remove the temp file/folder that was being written, and forget it.
# Called on failure, and on exit (see the trap in main).
cleanup() {
    if [[ -n "$TMP_PATH" ]]; then
        rm -rf -- "$TMP_PATH"
    fi
    TMP_PATH=""
}

usage() {
    cat <<'EOF'
Usage: extract [-h] [-r] [-v] file [file...]

Unpack archives in place. The type is detected with the `file` command,
so file names and extensions do not matter.

Supported: gzip (gunzip), bzip2 (bunzip2), zip (unzip), compress (uncompress).

Options:
  -h    show this help and exit
  -r    recursive: go into subfolders and into archives inside archives
  -v    verbose: print each file decompressed, warn for each file that was not

Output:     the number of archives decompressed
Exit code:  the number of files NOT decompressed (capped at 255), 2 on usage error
EOF
}

# Print an error and the usage to stderr, then exit 2 (incorrect usage).
usage_error() {
    echo "extract: $1" >&2
    usage >&2
    exit 2
}

# Print a warning to stderr, only with -v.
warn() {
    if (( verbose )); then
        echo "extract: warning: $*" >&2
    fi
}

# Read the options into the globals above.
# The caller removes them afterwards with: shift $((OPTIND - 1))
parse_args() {
    local opt
    OPTIND=1   # start from the first argument, even if called before

    # TEMPORARY: recursive is read from chunk 7 on. Remove this line then.
    # shellcheck disable=SC2034
    while getopts ":hrv" opt; do
        case "$opt" in
            h) usage; exit 0 ;;
            r) recursive=1 ;;
            v) verbose=1 ;;
            *) usage_error "unknown option: -$OPTARG" ;;
        esac
    done
}

main() {
    parse_args "$@"
    shift $((OPTIND - 1))

    if (( $# == 0 )); then
        usage_error "no files given"
    fi

    if ! command -v file >/dev/null; then
        echo "extract: the 'file' command is required but was not found" >&2
        exit 2
    fi

    # Remove a leftover temp file when the script exits, also on Ctrl+C.
    trap cleanup EXIT

    # Processing the files is added in the next chunks.
}

# Run only when the script is executed, not when it is sourced (for tests).
# "set" is here so the strict mode does not leak into a shell that sources us.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -uo pipefail
    main "$@"
fi
