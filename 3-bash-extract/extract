#!/usr/bin/env bash
# extract - unpack archives by their content type, not by their name.
# See README.md for usage and DECISIONS.md for design decisions.

# Options (set by parse_args)
verbose=0
recursive=0

# --- Supported types: mime type (from `file`) -> how to unpack -------------------
# To add a method, add one line to one of these tables, and add the type to the
# "Supported:" line in usage() (that list is written by hand, see D-002).
# declare -A = associative array (keys are strings). -g = global, so the tables
# stay global even when this file is sourced from inside a function (tests).

# Stream tools: one file in -> one file out. Value = a tool that supports -c (stdout).
# TEMPORARY: used from chunk 4 on. Remove this line then.
# shellcheck disable=SC2034
declare -gA STREAM_TOOLS=(
    [application/gzip]="gunzip"
    [application/x-gzip]="gunzip"          # older versions of `file`
    [application/x-bzip2]="bunzip2"
    [application/x-compress]="uncompress"
)

# Archive tools: one file in -> many files out. Value = a function below
# that takes: $1 = archive, $2 = folder to extract into.
# TEMPORARY: used from chunk 5 on. Remove this line then.
# shellcheck disable=SC2034
declare -gA ARCHIVE_TOOLS=(
    [application/zip]="unpack_zip"
)

unpack_zip() {
    unzip -o -q "$1" -d "$2"
}

# Print the mime type of a file, based on its content (never its name).
# -L: follow a symlink and report the type of the file it points to (D-006).
detect_type() {
    file -L -b --mime-type -- "$1"
}

usage() {
    cat <<'EOF'
Usage: extract [-h] [-r] [-v] file [file...]

Unpack archives in place. The type is detected with the `file` command,
so file names and extensions do not matter.

Supported: gzip (gunzip), bzip2 (bunzip2), zip (unzip), compress (uncompress).

Options:
  -h    show this help and exit
  -r    recursive: go into subfolders and into archives inside archives
  -v    verbose: print each file decompressed, warn for each file that was not

Output:     the number of archives decompressed
Exit code:  the number of files NOT decompressed (capped at 255), 2 on usage error
EOF
}

# Print an error and the usage to stderr, then exit 2 (incorrect usage).
usage_error() {
    echo "extract: $1" >&2
    usage >&2
    exit 2
}

# Read the options into the globals above.
# The caller removes them afterwards with: shift $((OPTIND - 1))
parse_args() {
    local opt
    OPTIND=1   # start from the first argument, even if called before

    # TEMPORARY: verbose/recursive are read from chunk 6 on. Remove this line then.
    # shellcheck disable=SC2034
    while getopts ":hrv" opt; do
        case "$opt" in
            h) usage; exit 0 ;;
            r) recursive=1 ;;
            v) verbose=1 ;;
            *) usage_error "unknown option: -$OPTARG" ;;
        esac
    done
}

main() {
    parse_args "$@"
    shift $((OPTIND - 1))

    if (( $# == 0 )); then
        usage_error "no files given"
    fi

    if ! command -v file >/dev/null; then
        echo "extract: the 'file' command is required but was not found" >&2
        exit 2
    fi

    # Processing the files is added in the next chunks.
}

# Run only when the script is executed, not when it is sourced (for tests).
# "set" is here so the strict mode does not leak into a shell that sources us.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    set -uo pipefail
    main "$@"
fi
